# --- Client (Vite, exposed to the browser) ---
# PostHog analytics. Events ARE wired (Day 2). Without a key the client renders
# fine and all capture calls no-op.
VITE_POSTHOG_KEY=phc_your_project_key_here
VITE_POSTHOG_HOST=https://us.i.posthog.com

# --- Server (Vercel functions + cron ingestion; NOT exposed to the browser) ---
# Neon Postgres connection string. Required before enabling the ingestion cron
# and the /api read endpoints.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Protects the cron endpoint from manual invocation. Vercel sets
# Authorization: Bearer <CRON_SECRET> on scheduled runs.
CRON_SECRET=generate_a_long_random_string
