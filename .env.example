# --- Client (Vite, exposed to the browser) ---
# PostHog analytics. Events ARE wired (Day 2). Without a key the client renders
# fine and all capture calls no-op.
VITE_POSTHOG_KEY=phc_your_project_key_here
VITE_POSTHOG_HOST=https://us.i.posthog.com

# --- Server (Vercel functions and the ingestion job; NOT exposed to the browser) ---
# Neon Postgres connection string. Required by the /api read endpoints and by
# the ingestion script (npm run ingest).
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# No CRON_SECRET. Scheduled ingestion moved from a Vercel cron to GitHub
# Actions (.github/workflows/ingest.yml), which authenticates with the
# DATABASE_URL repository secret. api/cron/ingest.ts is a retired 410 stub.
